{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.atlas.local/v0.2/command.json",
  "title": "ATLAS Command",
  "description": "MUDANÇAS v0.1→v0.2: (1) ciclo de vida ganhou EXECUTING/COMPLETED para actions duráveis — a v0.1 parava em CONFIRMED, que significa apenas 'a bomba ligou'; (2) CANCELLED existe, porque uma irrigação que não pode ser interrompida viola a §18; (3) UNKNOWN_OUTCOME existe, para o comando que estava em voo quando o Core reiniciou; (4) idempotencyKey ganhou escopo e janela; (5) 'result' ganhou forma; (6) causality.cause virou obrigatório quando actor=AUTOMATION — é esse elo que torna a detecção de loop possível.",
  "$defs": {
    "CommandStatus": {
      "enum": [
        "REQUESTED",
        "ACCEPTED",
        "REJECTED",
        "SENT",
        "ACKNOWLEDGED",
        "EXECUTING",
        "CONFIRMED",
        "COMPLETED",
        "FAILED",
        "TIMEOUT",
        "CANCELLED",
        "EXPIRED",
        "UNKNOWN_OUTCOME"
      ],
      "description": "Não-durável: REQUESTED→ACCEPTED→SENT→ACKNOWLEDGED→CONFIRMED (terminal). Durável: ...→ACKNOWLEDGED→EXECUTING→COMPLETED (terminal). Terminais: CONFIRMED, COMPLETED, REJECTED, FAILED, TIMEOUT, CANCELLED, EXPIRED, UNKNOWN_OUTCOME."
    },
    "CausalityRef": {
      "type": [
        "object",
        "null"
      ],
      "description": "O que causou isto. Um comando pode ser causado por um evento; um evento, por um comando. Por isso o tipo é explícito.",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "EVENT",
            "COMMAND"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ErrorCode": {
      "enum": [
        "DEVICE_UNREACHABLE",
        "DEVICE_RETIRED",
        "ADAPTER_UNAVAILABLE",
        "UNSUPPORTED_ACTION",
        "INVALID_PARAMETER",
        "SAFETY_LIMIT_EXCEEDED",
        "RATE_LIMITED",
        "LOOP_GUARD_TRIPPED",
        "NOT_AUTHORIZED",
        "DEVICE_REJECTED",
        "INTERNAL_ERROR"
      ]
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "actor",
    "origin",
    "target",
    "parameters",
    "criticality",
    "status",
    "statusHistory",
    "requestedAt",
    "timeoutMs",
    "idempotencyKey",
    "causality"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^cmd_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "actor": {
      "type": "object",
      "description": "QUEM quis. Distinto de 'origin', que é POR ONDE veio.",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "USER",
            "AUTOMATION",
            "SCHEDULE",
            "SYSTEM",
            "ADAPTER"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "UI",
            "API",
            "VOICE",
            "PHYSICAL",
            "AUTOMATION_ENGINE",
            "SCHEDULER",
            "ADAPTER"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": [
        "deviceId",
        "action"
      ],
      "properties": {
        "deviceId": {
          "type": "string",
          "pattern": "^dev_"
        },
        "action": {
          "type": "string",
          "description": "Chave de uma ActionDescriptor do device."
        }
      },
      "additionalProperties": false
    },
    "parameters": {
      "type": "object",
      "description": "Validado contra ActionDescriptor.parameters ANTES de sair de REQUESTED. Falha de validação → REJECTED com INVALID_PARAMETER.",
      "additionalProperties": true
    },
    "criticality": {
      "$ref": "https://schemas.atlas.local/v0.2/device.json#/$defs/Criticality",
      "description": "Resolvida no momento da criação (action.criticality, ou device.defaultCriticality). Congelada aqui para que a política aplicada seja auditável mesmo que o device mude depois."
    },
    "status": {
      "$ref": "#/$defs/CommandStatus",
      "description": "Denormalizado para consulta. A FONTE DA VERDADE é statusHistory."
    },
    "statusHistory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "status",
          "at"
        ],
        "properties": {
          "status": {
            "$ref": "#/$defs/CommandStatus"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "requestedAt": {
      "type": "string",
      "format": "date-time"
    },
    "dispatchedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "executingSince": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Só para actions duráveis. Quando a execução física começou."
    },
    "expectedCompletionAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Só para actions duráveis. Ultrapassar sem COMPLETED é overrun e deve gerar alerta — é o caso da bomba que não desligou."
    },
    "completedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time",
      "description": "Instante do estado TERMINAL, qualquer que ele seja. Para action durável significa fim da EXECUÇÃO, não fim do despacho — a ambiguidade da v0.1."
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "description": "Prazo para chegar a ACKNOWLEDGED. NÃO limita a execução de action durável — para isso existe safety.maxExecutionSeconds."
    },
    "idempotencyKey": {
      "type": "object",
      "description": "Sem escopo e janela, a chave é decorativa.",
      "required": [
        "value",
        "windowSeconds"
      ],
      "properties": {
        "value": {
          "type": "string"
        },
        "windowSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "Único por (deviceId, action, value) dentro desta janela. Repetição dentro dela retorna o comando original em vez de criar outro."
        }
      },
      "additionalProperties": false
    },
    "causality": {
      "type": "object",
      "required": [
        "traceId",
        "cause",
        "depth"
      ],
      "properties": {
        "traceId": {
          "type": "string",
          "description": "Nasce na CAUSA-RAIZ (evento físico, ação de usuário, disparo de timer) e propaga por tudo que descende dela. Nunca é regenerado no meio de uma cadeia."
        },
        "cause": {
          "$ref": "#/$defs/CausalityRef"
        },
        "depth": {
          "type": "integer",
          "minimum": 0,
          "description": "ATENÇÃO: depth sozinho NÃO previne loop. Pega recursão descontrolada, mas não o ciclo A→B→A que reseta a profundidade e dispara para sempre. É por isso que existe loopGuard abaixo."
        },
        "loopGuard": {
          "type": "object",
          "description": "Proteção real contra ciclo. O Core recusa o comando (REJECTED / LOOP_GUARD_TRIPPED) se o par já disparou mais de N vezes na janela.",
          "properties": {
            "chainKey": {
              "type": "string",
              "description": "Ex.: 'aut_luz_presenca:dev_spot_bancada'. Contado por janela deslizante."
            },
            "occurrencesInWindow": {
              "type": "integer"
            },
            "windowSeconds": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cancellation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "requestedByCommandId": {
          "type": "string"
        },
        "actor": {
          "type": "object"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "result": {
      "type": [
        "object",
        "null"
      ],
      "description": "Presente em todo estado terminal.",
      "required": [
        "outcome",
        "at"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "SUCCESS",
            "FAILURE",
            "CANCELLED",
            "UNKNOWN"
          ]
        },
        "errorCode": {
          "oneOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "errorMessage": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapterMessageId": {
          "type": [
            "string",
            "null"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "$comment": "Comando emitido por automação DEVE apontar o evento que o disparou. É esse elo que torna a detecção de loop e o rastro causal possíveis.",
      "if": {
        "properties": {
          "actor": {
            "properties": {
              "type": {
                "const": "AUTOMATION"
              }
            },
            "required": [
              "type"
            ]
          }
        },
        "required": [
          "actor"
        ]
      },
      "then": {
        "properties": {
          "causality": {
            "properties": {
              "cause": {
                "type": "object"
              }
            },
            "required": [
              "cause"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "examples": [
