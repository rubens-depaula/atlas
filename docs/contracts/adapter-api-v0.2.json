    "inboundDeviceAppeared": {
      "adapterInstanceId": "mqtt.home",
      "at": "2026-08-23T00:02:10-03:00",
      "kind": "DEVICE_APPEARED",
      "deviceAppeared": {
        "nativeId": "zigbee2mqtt/sensor_novo",
        "suggestedName": "Sensor novo",
        "deviceClass": "SENSOR",
        "metadata": {
