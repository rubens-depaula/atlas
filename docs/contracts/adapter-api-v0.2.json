      }
    },
    "inboundDeviceDisappeared": {
      "adapterInstanceId": "mqtt.home",
      "at": "2026-08-23T00:05:00-03:00",
      "kind": "DEVICE_DISAPPEARED",
      "deviceDisappeared": {
